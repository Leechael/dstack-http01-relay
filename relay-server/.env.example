# Example environment configuration for relay-server
# Copy this file to .env and customize the values

# Port to listen on (default: 8081)
# Use 80 for production with sudo, or expose 8081 via nginx
PORT=8081

# Hardened draft: challenge-only proxy. Redirect mode is no longer supported.
RELAY_MODE=proxy

# REQUIRED exact operator-approved gateway bases, comma-separated; no wildcards.
# CNAME must be exactly _.<one of these bases>; no regex or fallback.
ALLOWED_GATEWAY_DOMAINS=dstack-pha-prod2.phala.network

# Logging level
RUST_LOG=relay_server=info

# Legacy FALLBACK_GATEWAY_DOMAIN, ALLOWED_DOMAIN_REGEX and
# GATEWAY_DOMAIN_CAPTURE_GROUP are no longer used.
